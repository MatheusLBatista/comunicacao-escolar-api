# =============================================================================
# API
# =============================================================================
# Porta em que o servidor irá rodar
PORT=3010

# Porta do frontend utilizada no docker-compose
FRONTEND_PORT=3001

# Ambiente da aplicação (development/test/production)
NODE_ENV=development

# Ativa/desativa logs detalhados (true/false)
DEBUGLOG=true

# Origem permitida pelo CORS (use * para liberar tudo em desenvolvimento)
CORS_ORIGIN=*

# =============================================================================
# BANCO DE DADOS
# =============================================================================
# URL de conexão com o banco MongoDB
# Exemplos:
#   Local:  mongodb://localhost:27017/comunicacao-escolar
#   Atlas:  mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/comunicacao-escolar?retryWrites=true&w=majority
#   Docker: mongodb://mongodb:27017/comunicacao-escolar (configurado no docker-compose)
DB_URL=mongodb://localhost:27017/comunicacao-escolar

# URL de conexão com o banco de testes
DB_URL_TEST=mongodb://localhost:27017/comunicacao-escolar-test

# =============================================================================
# JWT
# =============================================================================
# Secrets para autenticação JWT
JWT_SECRET_ACCESS_TOKEN=GERE_UMA_CHAVE_SECRETA
JWT_SECRET_REFRESH_TOKEN=GERE_UMA_CHAVE_SECRETA
JWT_SECRET_PASSWORD_RECOVERY=GERE_UMA_CHAVE_SECRETA
JWT_SECRET_INVITE=GERE_UMA_CHAVE_SECRETA

# Tempo de expiração dos tokens JWT
# Formatos aceitos: s (segundos), m (minutos), h (horas), d (dias)
JWT_ACCESS_TOKEN_EXPIRATION=1d
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_PASSWORD_RECOVERY_EXPIRATION=15m

# Força uma única sessão ativa por usuário (true/false)
SINGLE_SESSION_REFRESH_TOKEN=false

# =============================================================================
# SERVIÇO DE E-MAIL
# =============================================================================
# Configurar conta Google para envio de e-mails via Gmail:
# 1) Acesse https://myaccount.google.com/security e habilite a verificação em duas etapas
# 2) Acesse https://myaccount.google.com/apppasswords e gere uma senha de app
# 3) Use o e-mail do Google e a senha de app gerada abaixo

# E-mail remetente (Gmail)
EMAIL_USER=seu_email@gmail.com

# Senha de aplicativo gerada (Gmail)
EMAIL_APP_PASSWORD=sua_senha_de_app_aqui

# Nome exibido no remetente dos e-mails
COMPANY_NAME=Comunicação Escolar

# URL do frontend (usada para gerar links nos e-mails)
FRONTEND_URL=http://localhost:3000

# Desativa o envio real de e-mails, apenas loga no console (true/false)
DISABLED_EMAIL=false

# =============================================================================
# MINIO
# =============================================================================
# Endpoint do servidor MinIO
MINIO_ENDPOINT=localhost

# Porta da API
MINIO_PORT=9000

# Porta do console web
MINIO_CONSOLE_PORT=9001

# Habilita SSL na conexão com o MinIO (true/false)
MINIO_USE_SSL=false

# Credenciais de acesso
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Nome do bucket principal (avatares, anexos, etc.)
MINIO_BUCKET=comunicacao-escolar

# URL pública para acesso via navegador
MINIO_PUBLIC_URL=http://localhost:9000

# =============================================================================
# FIREBASE (Push Notifications)
# =============================================================================
# Credenciais do Firebase Admin SDK para envio de notificações push.
# Gere em: https://console.firebase.google.com → Configurações do projeto → Contas de serviço
#
# Opção 1 (recomendada para produção): JSON completo da conta de serviço em uma única variável
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opção 2 (alternativa): variáveis separadas
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# GOOGLE AUTH
# =============================================================================
# Client ID do OAuth 2.0 para autenticação com Google
# Gere em: https://console.cloud.google.com → APIs e serviços → Credenciais
GOOGLE_CLIENT_ID=

# =============================================================================
# SWAGGER
# =============================================================================
# Credenciais de acesso à documentação da API (http://localhost:PORT/docs)
# Se não configurado, o Swagger fica acessível sem autenticação em development e bloqueado (404) em production
SWAGGER_USER=admin
SWAGGER_PASSWORD=DEFINA_UMA_SENHA

# =============================================================================
# USUÁRIO ADMINISTRADOR
# =============================================================================
# Dados do usuário administrador criado pelas seeds
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Senha@123
