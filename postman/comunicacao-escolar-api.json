                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Invalida o `access_token`. Pode receber o token pelo body (`access_token`) ou pelo header Authorization."
          }
        },
        {
          "name": "Revogar Token (Revoke)",
          "request": {
