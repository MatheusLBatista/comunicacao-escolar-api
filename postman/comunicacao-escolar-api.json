  "item": [
    {
      "name": "Auth",
      "description": "Rotas de autenticação: login, logout, refresh, revogação, recuperação e redefinição de senha.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.user) {",
                  "    const user = res.data.user;",
                  "    if (user.access_token)  pm.collectionVariables.set('access_token',  user.access_token);",
                  "    if (user.refresh_token) pm.collectionVariables.set('refresh_token', user.refresh_token);",
                  "    if (user._id)           pm.collectionVariables.set('user_id',       user._id);",
                  "    console.log('Tokens e user_id salvos com sucesso!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@escola.com\",\n  \"password\": \"Senha@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Autentica o usuário e salva automaticamente `access_token`, `refresh_token` e `user_id` nas variáveis da collection."
          }
        },
        {
          "name": "Listar Escolas (Salvar school_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const payload = body?.data;",
                  "let school = null;",
                  "if (Array.isArray(payload?.docs) && payload.docs.length) school = payload.docs[0];",
                  "else if (Array.isArray(payload) && payload.length) school = payload[0];",
                  "else if (payload && payload._id) school = payload;",
                  "if (school && school._id) {",
                  "  pm.collectionVariables.set(\"school_id\", school._id);",
                  "  console.log(\"school_id salvo:\", school._id);",
                  "} else {",
                  "  console.warn(\"Nenhuma escola encontrada para salvar school_id\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/schools?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "schools"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lista escolas e salva automaticamente o primeiro `_id` em `school_id` para uso nas rotas de usuários."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
