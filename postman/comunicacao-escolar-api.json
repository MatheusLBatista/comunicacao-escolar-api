            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "refresh"
              ]
            },
            "description": "Renova o `access_token` usando o `refresh_token`. O novo token é salvo automaticamente."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
